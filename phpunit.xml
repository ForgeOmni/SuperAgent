<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
        <testsuite name="Laravel">
            <directory>tests/Laravel</directory>
        </testsuite>
        <testsuite name="Compat">
            <directory>tests/Compat</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!--
        Deprecations fail the build, but only the ones this package can fix:
        `restrictDeprecations` narrows reporting to the source set below, so a
        dev dependency that has not caught up with a new PHP release (Laravel's
        console helpers and Testbench's database config both trigger 8.5
        deprecations today) cannot turn the suite red.

        PHPUnit 12 renamed the attribute to `ignoreIndirectDeprecations` and
        reports this file as "a deprecated schema" because of it — but it still
        honours the old name, and the new one does not exist in PHPUnit 10's
        schema, which the PHP 8.1 leg is pinned to. One config has to serve
        both, so the old name stays until PHP 8.1 support is dropped.
    -->
    <source restrictDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <env name="ANTHROPIC_API_KEY" value="" force="false"/>
    </php>
</phpunit>
